<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F4EE"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/content_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:text="OperateBarLayout Demo"
        android:textColor="#FF1F1A16"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/btn_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/content_title">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_toggle_divider"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="关闭分隔线" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_toggle_primary"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="隐藏主操作" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_toggle_secondary"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="隐藏复杂项" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/btn_row2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_row">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_toggle_width"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="主操作自定义宽度" />

    </LinearLayout>

    <io.github.xesam.android.operatebar.OperateBarLayout
        android:id="@+id/operate_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="#FFFFFEFC"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_row2"
        app:layout_constraintVertical_bias="1.0"
        app:oblDividerLayout="@layout/divider_default">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/action_cancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="取消"
            android:textColor="#FF5A5047" />

        <RelativeLayout
            android:background="#22ff5500"
            android:id="@+id/action_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_oblIsPrimary="true">

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Material3.Button"
                android:layout_width="98dp"
                android:layout_height="108dp"
                android:layout_centerHorizontal="true"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="主操作" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/action_secondary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="#12F57C00"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/complex_item_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="Left"
                android:textColor="#FF5A5047"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/complex_item_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="Right"
                android:textColor="#FF5A5047"
                android:textSize="12sp" />
        </RelativeLayout>
    </io.github.xesam.android.operatebar.OperateBarLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
